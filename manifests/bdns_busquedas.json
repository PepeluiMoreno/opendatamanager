{
  "odm_manifest_version": 1,
  "publisher": {
    "acronimo": "BDNS",
    "nombre": "Base de Datos Nacional de Subvenciones",
    "nivel": "ESTATAL",
    "pais": "España",
    "portal_url": "https://www.infosubvenciones.es"
  },
  "resources": [
    {
      "name": "BDNS - Convocatorias de Subvenciones",
      "fetcher": "API REST",
      "clase_fuente": "api_abierta",
      "schedule": "0 3 5 * *",
      "active": true,
      "description": "Todas las convocatorias de subvenciones publicadas en la BDNS (SNPSAP). Intervalo temporal por parámetros de ejecución fecha_desde/fecha_hasta (ISO); sin ellos, corpus íntegro.",
      "params": [
        {
          "key": "url",
          "value": "https://www.infosubvenciones.es/bdnstrans/api/convocatorias/busqueda",
          "is_external": false
        },
        {
          "key": "method",
          "value": "GET",
          "is_external": false
        },
        {
          "key": "query_params",
          "value": "{\"vpd\": \"GE\", \"fechaDesde\": \"{fecha_desde}\", \"fechaHasta\": \"{fecha_hasta}\"}",
          "is_external": false,
          "help": "vpd + ventana temporal. fechaDesde/fechaHasta son marcadores de RUNTIME: la ejecución aporta fecha_desde/fecha_hasta en formato dd/mm/yyyy (verificado contra el SNPSAP; ISO da 400). Si faltan, se omiten y trae todo el corpus."
        },
        {
          "key": "pagination",
          "value": "page_number",
          "is_external": false
        },
        {
          "key": "page_param",
          "value": "page",
          "is_external": false
        },
        {
          "key": "page_size_param",
          "value": "pageSize",
          "is_external": false
        },
        {
          "key": "page_size",
          "value": "1000",
          "is_external": false
        },
        {
          "key": "start_page",
          "value": "0",
          "is_external": false
        },
        {
          "key": "content_field",
          "value": "content",
          "is_external": false
        },
        {
          "key": "timeout",
          "value": "120",
          "is_external": false
        },
        {
          "key": "delay_between_pages",
          "value": "0.3",
          "is_external": false,
          "help": "Cortesía entre páginas para no saturar el SNPSAP en backfills largos."
        },
        {
          "key": "max_records",
          "value": "0",
          "is_external": false,
          "help": "0 = sin límite (corpus completo). Útil acotar en pruebas."
        }
      ]
    },
